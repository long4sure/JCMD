# Example environment variables — this file IS committed to document required
# env vars. Copy to .env.local and fill in real values there (never commit
# .env.local).

# Supabase project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public API key (Project Settings → API → anon public key)
# Safe to expose to the browser (NEXT_PUBLIC_ prefix) — protected by RLS policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (Project Settings → API → service_role key)
# SECRET — server-side only, bypasses RLS. Never expose to the client/browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key (https://resend.com/api-keys)
# SECRET — server-side only, used to send transactional emails.
RESEND_API_KEY=

# Verified "from" address/domain to send emails from via Resend
EMAIL_FROM=
